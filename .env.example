# App & White-Label Mode
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_MODE=real

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (Test Mode by default)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMS (console | twilio)
SMS_DRIVER=console
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+13055550100

# Mapbox (Optional — falls back to local haversine & interactive SVG map when unset)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
MAPBOX_SERVER_TOKEN=sk.eyJ...

# Initial Owner Bootstrap (used by pnpm create-owner)
INITIAL_OWNER_EMAIL=owner@coolairmiami.com
INITIAL_OWNER_PASSWORD=ChangeMe123!
CRON_SECRET=change-me-32-hex

