# ==============================================================================
# ServicePro OS - Production Environment Configuration Template
# Copy this file to .env.production (or set these in Render / Vercel dashboard)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION URL & MODE
# ------------------------------------------------------------------------------
# Fully qualified public URL of your live production deployment (HTTPS required)
NEXT_PUBLIC_APP_URL=https://heavenlease.in
NEXT_PUBLIC_API_MODE=real
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SUPABASE PRODUCTION CREDENTIALS
# ------------------------------------------------------------------------------
# Retrieve from: Supabase Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL: Your production project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-production-ref.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Client-side safe public anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SUPABASE_SERVICE_ROLE_KEY: Server-only administrative key (NEVER expose to browser)
# Used for initial schema migration, service role operations, and admin sync
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. STRIPE PRODUCTION PAYMENT GATEWAY (LIVE MODE)
# ------------------------------------------------------------------------------
# Retrieve from: Stripe Dashboard -> Developers -> API Keys (Toggle Live Mode)
# Live Publishable Key (starts with pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key

# Live Secret Key (starts with sk_live_)
STRIPE_SECRET_KEY=sk_live_your_live_secret_key

# Webhook Signing Secret (starts with whsec_)
# Retrieve from: Stripe Dashboard -> Developers -> Webhooks -> Add Endpoint (/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_signing_secret

# ------------------------------------------------------------------------------
# 4. TWILIO 2-WAY DISPATCH SMS (LIVE MODE)
# ------------------------------------------------------------------------------
# Set SMS_DRIVER=twilio in production for real customer and technician SMS
SMS_DRIVER=twilio
TWILIO_ACCOUNT_SID=AC_your_production_account_sid
TWILIO_AUTH_TOKEN=your_production_auth_token
# Valid 10-digit E.164 Twilio phone number with SMS capability
TWILIO_FROM_NUMBER=+13055550100

# ------------------------------------------------------------------------------
# 5. MAPBOX MAPPING & ROUTING (OPTIONAL)
# ------------------------------------------------------------------------------
# If omitted, platform falls back cleanly to local haversine GPS and SVG maps
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ_your_public_token
MAPBOX_SERVER_TOKEN=sk.eyJ_your_secret_token

# ------------------------------------------------------------------------------
# 6. SYSTEM SECURITY & CRON AUTOMATION
# ------------------------------------------------------------------------------
# High-entropy random 32+ character secret for securing /api/cron/housekeeping
CRON_SECRET=generate_a_random_32_character_hex_secret_here

# Initial Owner Administrator Credentials (Used by 'pnpm create-owner')
INITIAL_OWNER_EMAIL=admin@yourdomain.com
INITIAL_OWNER_PASSWORD=UseAStrongRandomPassword2026!#
